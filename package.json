{
    "name": "existing-network-monitoring-system",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -k --names \"LARAVEL,PYTHON\" -c \"blue,yellow\" \"php artisan serve --port=8000\" \"python -u app.py\"",
        "dev:all": "concurrently -k --names \"LARAVEL,PYTHON\" -c \"blue,yellow\" \"php artisan serve --port=8000\" \"python -u app.py\"",
        "start": "concurrently -k --names \"LARAVEL,PYTHON\" -c \"blue,yellow\" \"php artisan serve --port=8000\" \"python -u app.py\"",
        "serve:laravel": "php artisan serve --port=8000",
        "serve:python": "python -u app.py",
        "ml:status": "python -u train_pipeline.py --status",
        "train:if": "python -u train_pipeline.py --model isolation_forest",
        "train:gru": "python -u train_pipeline.py --model gru",
        "train:xgb": "python -u train_pipeline.py --model xgboost",
        "train:all": "python -u train_pipeline.py --model all",
        "train:online": "python -u train_pipeline.py --import-online --model all"
    },
    "devDependencies": {
        "concurrently": "^9.1.2"
    }
}
